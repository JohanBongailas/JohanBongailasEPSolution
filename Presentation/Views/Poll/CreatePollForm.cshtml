@{
    ViewData["Title"] = "Create Poll";
}

<div class="container my-5">
    <h2 class="text-center text-primary mb-4">Create Poll</h2>

    @* Display the success message from TempData if present *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible autoDismissAlert fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <script>
            setTimeout(function () {
                var alertEl = document.getElementById('autoDismissAlert');
                if (alertEl) {
                    var bsAlert = bootstrap.Alert.getOrCreateInstance(alertEl);
                    bsAlert.close();
                }
            }, 4000); // Auto-dismiss after 4 seconds
        </script>
    }

    <form method="post" asp-controller="Poll" asp-action="CreatePoll" class="bg-light p-4 rounded shadow-sm">
        <div class="form-group mb-3">
            <label for="title" class="h5">Poll Title</label>
            <input type="text" class="form-control" id="title" name="title" required />
        </div>

        <div class="form-group mb-3">
            <label for="option1Text" class="h5">Option 1 Text</label>
            <input type="text" class="form-control" id="option1Text" name="option1Text" required />
        </div>

        <div class="form-group mb-3">
            <label for="option2Text" class="h5">Option 2 Text</label>
            <input type="text" class="form-control" id="option2Text" name="option2Text" required />
        </div>

        <div class="form-group mb-3">
            <label for="option3Text" class="h5">Option 3 Text</label>
            <input type="text" class="form-control" id="option3Text" name="option3Text" required />
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-primary btn-lg px-5">Create Poll</button>
        </div>
    </form>
</div>
